SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/payment_db
DB_USERNAME=payment_user
DB_PASSWORD=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Two DIFFERENT, persistent, random secrets, each Base64 of at least 32 bytes.
PASSWORD_PEPPER=
OTP_HMAC_KEY=
BCRYPT_COST=12
